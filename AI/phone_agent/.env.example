# 이 파일을 .env로 복사해 값을 채웁니다. .env는 Git에 올리지 않습니다.

# 한국AI통신 API 주소. 도메인까지만 적습니다(코드가 /v1/accounts/{KAT_ACCOUNT_ID}를 붙임)
KAT_BASE_URL=
# 한국AI통신: 대시보드 > 개발자 > API 키
KAT_API_KEY=
KAT_ACCOUNT_ID=
# 살구 방문예약 비서의 에이전트 ID
KAT_AGENT_ID=
# 속도 실험용 에이전트 ID(선택). trial run --agent high 처럼 이름으로 쓴다
KAT_AGENT_ID_HIGH=
KAT_AGENT_ID_REALTIME=
KAT_AGENT_ID_LIVE=
# 계정이 소유한 070 발신 번호 (숫자만). 등기부 문자도 이 번호로 받고, 알림 문자도 이 번호에서 보냅니다.
KAT_FROM_NUMBER=

# mock: 전화를 걸지 않음 / demo: 아래 시연 번호로만 실제 발신
PHONE_AGENT_MODE=mock
# demo 모드에서 전화를 받을 번호(숫자만). 하나면 모든 전화(문의·재발신·확정)가 그 번호로 갑니다.
# 쉼표로 둘 이상 적으면 사무소 순서대로 나눠 겁니다(1번 사무소→첫 번호, 2번→둘째 번호…). 재발신·확정은 처음 받은 번호로.
PHONE_AGENT_DEMO_TO=

# 통화 결과 추출용 LLM(OpenAI 호환). demo 모드에서 필요하며, 없으면 결론이 unclear로 나옵니다.
OPENAI_API_KEY=
PHONE_AGENT_LLM_MODEL=gpt-6-luna

# 선택 값
# 시연용: 영업시간(월~토 9~19시) 밖에도 바로 발신하려면 1
PHONE_AGENT_IGNORE_HOURS=0
# 받지 않았을 때 다시 걸기까지 기다리는 분. 실제 운영은 30, 해커톤 시연은 1~2로 줄입니다.
PHONE_AGENT_RETRY_MINUTES=30
# 하루 문의 통화 수
PHONE_AGENT_DAILY_LIMIT=10
# 문의 통화 하나당 하루 확정 통화 수
PHONE_AGENT_CONFIRM_LIMIT=2
# 한 번호로 시연할 때 앞 통화가 끝나고 다음 통화까지 쉬는 초
PHONE_AGENT_CALL_GAP_SEC=0
# 영업일에서 뺄 날(쉼표로 YYYY-MM-DD). 기본 공휴일 목록에 더합니다.
PHONE_AGENT_HOLIDAYS=
# 동의한 대화 전문을 보관하는 날 수
PHONE_AGENT_TRANSCRIPT_DAYS=30
# 사용자가 올린 등기부 PDF를 메모리에 두는 최대 시간(사실 정리 뒤 DELETE로 바로 지우는 게 기본)
PHONE_AGENT_UPLOAD_KEEP_HOURS=24

# 알림: 카카오톡 '나에게 보내기'. 토큰이 없거나 실패하면 demo 모드에서 문자로 보냅니다.
# 카카오 로그인(talk_message 동의)으로 받은 사용자 토큰
KAKAO_ACCESS_TOKEN=
# 토큰 갱신용(선택)
KAKAO_REFRESH_TOKEN=
KAKAO_REST_API_KEY=
# 알림 문자를 받을 번호. 비우면 PHONE_AGENT_DEMO_TO
PHONE_AGENT_NOTIFY_TO=
# 알림에 붙일 살구 화면 주소(선택)
PHONE_AGENT_APP_URL=
# 녹음: 비우면 발신 번호 설정을 따름, 0이면 녹음하지 않음(사후 전사도 없어 대화록은 실시간 전사 liveEvents로 받음)
PHONE_AGENT_RECORD=
# MCP(/mcp)는 기본으로 localhost 주소로 온 요청만 받습니다. 배포해서 다른 주소로 부르려면 0.0.0.0
PHONE_AGENT_MCP_HOST=127.0.0.1
# API를 부를 수 있는 화면 주소(쉼표로 구분). 기본은 모두 허용
PHONE_AGENT_CORS_ORIGINS=*

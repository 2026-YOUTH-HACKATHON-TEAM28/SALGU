# 서버 환경 변수 예시. 실제 값은 .env(Git 제외)나 systemd EnvironmentFile 에만 둬요.

# 서버 포트 (운영 8080)
PORT=8080
# 바깥에서 받을 주소 (운영 0.0.0.0, 개발 127.0.0.1)
HOST=127.0.0.1
# mock 데이터 저장 폴더
DATA_DIR=.data
# 앞단 프록시(Caddy) 뒤에서 https 쿠키·방문자 IP를 쓰려면 프록시 주소(쉼표로 여러 개) 또는 1(모두 믿음)
TRUST_PROXY=
# 카카오맵 JavaScript 키. 비우면 OpenStreetMap 으로 대체
KAKAO_MAP_KEY=
# mock 통화 진행 속도 배수 (1 = 실제와 비슷하게, 시험은 크게)
MOCK_TIME_SCALE=1

# OpenAI(대화 보조). 비우면 규칙으로만 답해요
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# 하루 전체 AI 호출 상한
AI_DAILY_CAP=400
# AI 폴더 대화 에이전트(AI/chat_agent) 주소. 비우면 이 서버 규칙(+OpenAI)으로만 답해요
CHAT_AGENT_URL=

# AI 폴더 전화 에이전트(AI/phone_agent) 주소. 비우면 통화는 이 서버 시뮬레이션
PHONE_AGENT_URL=
# 전화 에이전트 mock 모드에서 쓸 시나리오(X-Mock-Scenario). 비우면 에이전트 기본값
PHONE_AGENT_MOCK_SCENARIO=
# 동네마다 전화할 중개사무소 수(시연 기본 1)
PHONE_BROKERS_PER_DONG=1
# 1이면 등록번호에 시각을 붙여 같은 사무소 하루 1번 규칙을 피해요(시연용). 운영은 0
PHONE_UNIQUE_REG=1
# BE(Spring Boot) 주소. 있으면 카카오 로그인을 BE 로 넘겨요. 비우면 예시 계정
BE_URL=
# 카카오 로컬 REST 키(동네·회사 좌표)
KAKAO_REST_API_KEY=
# 카카오톡 알림(나에게 보내기) 전용 앱의 REST API 키(시크릿은 그 앱에서 켰을 때만).
# 그 앱의 카카오 로그인 Redirect URI 에 <사이트>/api/notify/kakao/callback, 동의 항목 '카카오톡 메시지 전송' 필요
KAKAO_REST_API_KEY_NOTIFY=
KAKAO_CLIENT_SECRET_NOTIFY=

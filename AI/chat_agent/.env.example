# 이 파일을 같은 폴더의 .env로 복사해 값을 채웁니다. .env는 Git에 올리지 않습니다.

# Google AI Studio에서 발급한 Gemini API 키
GEMINI_API_KEY=
# 사용할 Gemini 모델 ID. 비워 두면 연결 확인 때 목록에서 찾은 flash-lite 모델을 씁니다.
GEMINI_MODEL=

# 공공데이터포털(data.go.kr) 일반 인증키(Decoding). 키 하나로 활용신청한 여러 API를 호출합니다.
# 필요한 API: 건축HUB 건축물대장정보, 오피스텔·연립다세대 매매 실거래가, 오피스텔·연립다세대 전월세 실거래가
DATA_GO_KR_SERVICE_KEY=
# 카카오 REST API 키: 주소 → 법정동코드·지번 변환(로컬 API)
KAKAO_REST_API_KEY=
# ODsay 대중교통 길찾기 키 (기본 흐름의 통근 계산용, 나중에 필요)
ODSAY_API_KEY=

# --- 아래는 모두 선택. 비워 두면 기본값 ---
# Gemini 무료 등급 대응: 한 번에 기다리는 초(기본 8), 이 서버의 분당 최대 요청 수(기본 10),
# 한도 초과(429) 뒤 쉬는 초(기본 60). 늦거나 한도에 걸리면 기다리지 않고 규칙 결과로 답합니다.
GEMINI_TIMEOUT_S=
GEMINI_MAX_RPM=
GEMINI_COOLDOWN_S=
# 무료 한도는 모델마다 따로. GEMINI_MODEL이 한도에 걸리면 차례로 넘어갈 모델(쉼표 구분, 기본 gemini-3.5-flash-lite)
GEMINI_FALLBACK_MODELS=
# 추천 이유를 Gemini로 쓰려면 1 (기본은 코드 템플릿: 즉시, 숫자 정확)
EXPLAIN_WITH_LLM=

# 받을 서울 데이터 폴더 (기본: 저장소 data/api/public/ 아래 seoul_rent, seoul_subway, seoul_bus, seoul_youth_housing)
# 원본이 커서 저장소 밖에 둘 때만 경로를 적습니다. 형식은 docs/data_slots.md
SEOUL_RENT_DIR=
SEOUL_SUBWAY_DIR=
SEOUL_BUS_DIR=
SEOUL_YOUTH_DIR=
# 후보 검색에 쓰는 최근 개월 수 (기본 3)
RENT_MONTHS=

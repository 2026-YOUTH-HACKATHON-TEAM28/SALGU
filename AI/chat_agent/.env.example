# 이 파일을 같은 폴더의 .env로 복사해 값을 채웁니다. .env는 Git에 올리지 않습니다.

# Google AI Studio에서 발급한 Gemini API 키 (무료 등급)
GEMINI_API_KEY=
# 사용할 Gemini 모델 ID. 비워 두면 gemini-3.1-flash-lite
GEMINI_MODEL=

# --- 아래는 모두 선택. 비워 두면 기본값 ---
# Gemini 무료 등급 대응: 한 번에 기다리는 초(기본 8), 이 서버의 분당 최대 요청 수(기본 10),
# 한도 초과(429) 뒤 쉬는 초(기본 60). 늦거나 한도에 걸리면 기다리지 않고 규칙 결과로 답합니다.
GEMINI_TIMEOUT_S=
GEMINI_MAX_RPM=
GEMINI_COOLDOWN_S=
# 무료 한도는 모델마다 따로. GEMINI_MODEL이 한도에 걸리면 차례로 넘어갈 모델(쉼표 구분, 기본 gemini-3.5-flash-lite)
GEMINI_FALLBACK_MODELS=

# BE 집 검색 API 주소. 비워 두면 로컬 예시 응답을 씁니다(로컬 시험용)
BACKEND_SEARCH_URL=
BACKEND_TIMEOUT_S=

# 세션 캐시(대화 상태 JSON) 폴더와 만료 시간. 비워 두면 AI/chat_agent/.cache/sessions, 24시간
SESSION_CACHE_DIR=
SESSION_TTL_HOURS=

# 매물 추천 엔진(AI/property_recommendation)이 읽는 실거래 DB(Supabase PostgreSQL). 비워 두면 로컬 예시 응답
# 포트는 6543(트랜잭션 모드) 권장: 5432(세션 모드)는 팀 전체 동시 접속이 15개로 제한됨
SALGU_DB_HOST=
SALGU_DB_PORT=
SALGU_DB_NAME=
SALGU_DB_USER=
SALGU_DB_PASSWORD=
# 추천 한 번을 기다리는 초 (기본 20)
RECOMMEND_TIMEOUT_S=

# 매물 주소 → 좌표(버스 배차·가까운 역 계산용). 실거래 DB에 좌표가 없어 주소로 찾습니다.
# GEOCODER=kakao(기본): KAKAO_REST_API_KEY — 카카오 개발자 콘솔에서 '카카오맵'을 켠 앱의 REST API 키
# GEOCODER=vworld: VWORLD_API_KEY — 브이월드 오픈API 인증키 (역 이름 검색은 지원 안 함)
# 키가 없으면 교통 지표 없이 추천합니다. 전체 미리 채우기: scripts/geocode_buildings.py
GEOCODER=
KAKAO_REST_API_KEY=
VWORLD_API_KEY=
# 좌표 캐시 파일(AI/chat_agent 기준 경로). 비워 두면 .cache/geo/coords.json
GEO_CACHE_FILE=

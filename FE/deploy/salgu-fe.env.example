# 서버의 ~/salgu-fe/salgu-fe.env (권한 600) 예시. 키 값은 서버 파일에만 둬요.
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
# Caddy(도커) 에서 오는 요청만 믿어요
TRUST_PROXY=127.0.0.1,172.16.0.0/12
DATA_DIR=__HOME__/salgu-fe/data
CLIENT_DIR=__HOME__/salgu-fe/current/dist/client
MOCK_TIME_SCALE=1
LOG_LEVEL=info
# 카카오맵 JavaScript 키(사이트 도메인 등록 필요). 비우면 OpenStreetMap
KAKAO_MAP_KEY=
# OpenAI(대화 보조) 키. 비우면 규칙으로만 답해요
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_DAILY_CAP=400
# AI 폴더 대화 에이전트 주소(같은 서버에 띄우면 http://127.0.0.1:8095)
CHAT_AGENT_URL=

# AI 폴더 전화 에이전트(AI/phone_agent) 주소. 비우면 통화는 이 서버 시뮬레이션
PHONE_AGENT_URL=
# 전화 에이전트 mock 모드에서 쓸 시나리오(X-Mock-Scenario). 비우면 에이전트 기본값
PHONE_AGENT_MOCK_SCENARIO=
# 동네마다 전화할 중개사무소 수(시연 기본 1)
PHONE_BROKERS_PER_DONG=1
# 1이면 등록번호에 시각을 붙여 같은 사무소 하루 1번 규칙을 피해요(시연용). 운영은 0
PHONE_UNIQUE_REG=1
# BE(Spring Boot) 주소. 있으면 카카오 로그인을 BE 로 넘겨요. 비우면 예시 계정
BE_URL=

# 서버 환경 변수 예시. 실제 값은 .env(Git 제외)나 systemd EnvironmentFile 에만 둬요.

# 서버 포트 (운영 8080)
PORT=8080
# 바깥에서 받을 주소 (운영 0.0.0.0, 개발 127.0.0.1)
HOST=127.0.0.1
# mock 데이터 저장 폴더
DATA_DIR=.data
# 앞단 프록시(Caddy) 뒤에서 https 쿠키·방문자 IP를 쓰려면 프록시 주소(쉼표로 여러 개) 또는 1(모두 믿음)
TRUST_PROXY=
# 카카오맵 JavaScript 키. 비우면 OpenStreetMap 으로 대체
KAKAO_MAP_KEY=
# mock 통화 진행 속도 배수 (1 = 실제와 비슷하게, 시험은 크게)
MOCK_TIME_SCALE=1
